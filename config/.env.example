# Oracle
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_DSN=host:1521/service_name

# Google Workspace
GOOGLE_APPLICATION_CREDENTIALS=config/google-service-account.json
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/bigquery

# Pipeline Detecciones SEMA
GOOGLE_DETECCIONES_DRIVE_FOLDER_ID=your_drive_folder_id
GOOGLE_DETECCIONES_SHEET_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/edit#gid=0
GOOGLE_DETECCIONES_WORKSHEET=Registro_2026_Temp
DETECCIONES_SEMA_MAX_STALENESS_DAYS=1

# Pipeline Detecciones 30 min
# Reutiliza GOOGLE_DETECCIONES_DRIVE_FOLDER_ID para historicos (mismo origen del pipeline 01)
GOOGLE_DETECCIONES_30MIN_DRIVE_ROOT_FOLDER_ID=your_30min_root_folder_id
DETECCIONES_30MIN_MAX_DELAY_MINUTES=120
DETECCIONES_30MIN_FRESHNESS_ALERT_START_HOUR=8
DETECCIONES_30MIN_FRESHNESS_ALERT_END_HOUR=20

# Pipeline Estados SEMA SUA
ESTADOS_SUA_SHEET_URL=https://docs.google.com/spreadsheets/d/your_estados_sheet_id/edit#gid=0
ESTADOS_SUA_REGISTRO_WORKSHEET=Registro
ESTADOS_SUA_ESTADOS_WORKSHEET=Estados
ESTADOS_SUA_DRIVE_FOLDER_ID=your_estados_drive_folder_id
ESTADOS_SUA_MAX_STALENESS_HOURS=24

# Pipeline Planes SEMA
PLANES_SHEET_URL=https://docs.google.com/spreadsheets/d/your_planes_sheet_id/edit#gid=0
PLANES_REGISTRO_WORKSHEET=Registro
PLANES_ACTUAL_WORKSHEET=Planes
PLANES_DRIVE_FOLDER_ID=your_planes_drive_folder_id
PLANES_MAX_STALENESS_HOURS=24
PLANES_HISTORY_LOOKBACK_WEEKS=1
PLANES_ACTUALIZACION_SUANET_SGM_ENABLED=false

# Conexion Oracle opcional SUANET-SGM (solo si PLANES_ACTUALIZACION_SUANET_SGM_ENABLED=true):
PLANES_SGM_ORACLE_USER=your_sgm_user
PLANES_SGM_ORACLE_PASSWORD=your_sgm_password
PLANES_SGM_ORACLE_DSN=host:1521/service_name
PLANES_SGM_SCHEMA=XXXXX

# Pipeline Anexo SEMA
ANEXO_SHEET_URL=https://docs.google.com/spreadsheets/d/your_anexo_sheet_id/edit#gid=0
ANEXO_WORKSHEET=1.INTERSECCIONES.
ANEXO_DATA_RANGE=A4:CH2500
ANEXO_ORACLE_TABLE=esp_int_sema

# Pipeline Mantenimiento SEMA
MANTENIMIENTO_SHEET_URL=https://docs.google.com/spreadsheets/d/your_mantenimiento_sheet_id/edit#gid=0
MANTENIMIENTO_DATA_RANGE=A1:Z1000000
MANTENIMIENTO_ORACLE_TABLE=mtto_hist_sema

# Pipeline KPI SEMA
KPI_SHEET_URL=https://docs.google.com/spreadsheets/d/your_kpi_sheet_id/edit#gid=0
KPI_WORKSHEET=KPI
KPI_DATA_RANGE=A1:L10000
KPI_ORACLE_TABLE=disp_kpi_sema

# Pipeline FIN SEM SEMA
# Reutiliza GOOGLE_DETECCIONES_DRIVE_FOLDER_ID para historicos (mismo origen del pipeline 01)
FIN_SEM_SEMA_YEARS=2024,2025,2026,2027
FIN_SEM_SEMA_INCLUDE_FRIDAY=true
FIN_SEM_SEMA_REGLAS_PATH=config/fin_sem_sema_reglas.csv
FIN_SEM_SEMA_REGISTRO_SHEET_URL=https://docs.google.com/spreadsheets/d/your_fin_sem_sheet_id/edit#gid=0
FIN_SEM_SEMA_REGISTRO_WORKSHEET=Registro_2026
FIN_SEM_SEMA_HOY_DRIVE_FOLDER_ID=your_fin_sem_hoy_folder_id

# Alertas por correo (opcional)
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=alerts@your-domain.com
ALERT_EMAIL_TO=ops@your-domain.com
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
# true para STARTTLS (normalmente 587), false para relay interno sin TLS
SMTP_USE_TLS=true
# true para autenticacion (usuario/clave), false para SMTP relay sin login
SMTP_USE_AUTH=true
SMTP_USER=alerts@your-domain.com
SMTP_PASSWORD=your_smtp_password

# Registro central de alertas en Google Sheets (opcional)
ALERTS_SHEET_URL=https://docs.google.com/spreadsheets/d/your_alerts_sheet_id/edit#gid=0
ALERTS_SHEET_WORKSHEET=pipeline_alerts
